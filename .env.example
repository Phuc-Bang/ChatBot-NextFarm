# Sao chep thanh .env roi dien gia tri that. KHONG commit file .env.
# Cac gia tri de trong o day la co y: quy chuan v2.0 muc 0.4 cam bia du lieu.

# --- PostgreSQL ---
POSTGRES_USER=nextfarm
POSTGRES_PASSWORD=nextfarm
POSTGRES_DB=nextfarm
# 55432 chu khong phai 5432: tranh dung cong voi PostgreSQL cai san tren may
POSTGRES_PORT=15432
DATABASE_URL=postgresql+psycopg://nextfarm:nextfarm@localhost:15432/nextfarm

# --- LLM ---
# Model cu the CHUA CHOT (DEC-015 = TODO). Chi dien sau khi benchmark.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# --- Embedding / Reranker ---
# TODO: chot sau khi do Recall@K (muc 26)
EMBEDDING_MODEL=
# BAT reranker: R@5 72.7 -> 90.9, chi phi +459 ms (GPU) hoac +4.208 ms (CPU).
# Do va ly do day du: docs/reports/P6_reranker.md
# De trong = tat. RERANKER_DEVICE=cpu neu may trien khai khong co GPU.
RERANKER_MODEL=itdainb/PhoRanker
RERANKER_DEVICE=cuda

# --- Trang quan tri ---
# De trong = /admin chi phuc vu may cuc bo (127.0.0.1). Do la trai nghiem PoC
# hom nay va khong phai cau hinh gi.
# BAT BUOC dat mot chuoi ngau nhien truoc khi deploy ra dia chi cong khai -
# khong dat thi server TU CHOI moi request tu ngoai loopback, chu khong lang
# le phuc vu. Sinh chuoi: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Crawler ---
# Dia chi lien he that, de trong User-Agent (DEC-028b)
CRAWLER_CONTACT_EMAIL=
